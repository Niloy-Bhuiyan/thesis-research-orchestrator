# Copy to .env and fill in. Never commit .env.
# Most secrets live as files under .secrets/ instead; these are for the
# dashboard build and for CI, which cannot read that directory.

# --- Dashboard (public, safe to expose in the browser bundle) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_RUNNER_ID=your-laptop-name

# --- Local daemon (never expose these in the browser) ---
# The daemon reads these from .secrets/ by default; set them only if you
# prefer environment variables.
# SUPABASE_SERVICE_ROLE_KEY=
# TELEGRAM_BOT_TOKEN=
# RESEARCHOS_API_TOKEN=

# --- Kaggle ---
# Preferred: ~/.kaggle/kaggle.json created from the Kaggle settings page.
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# --- Paid API fallback stays OFF unless deliberately enabled ---
# RESEARCHOS_ALLOW_PAID_FALLBACK=false
